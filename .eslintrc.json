{
  "root": true,
  "env": { "node": true, "es2023": true, "jest": true },
  "parserOptions": { "ecmaVersion": 2023, "sourceType": "script" },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "prefer-const": "error",
    "eqeqeq": "error"
  }
}
